    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "^58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "^19.3.0"
  }
