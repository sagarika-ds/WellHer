# ===== Copy to .env and replace every CHANGE_ME. Never commit .env =====
APP_ENV=development
LOG_LEVEL=INFO

# --- Core backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://wellness:CHANGE_ME@postgres:5432/wellness
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
FIELD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
CORS_ORIGINS=http://localhost:8081
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
EVENTS_INLINE=false          # true only for local debugging/tests; must be false in production
EMAIL_BACKEND=console        # console (dev only) | disabled. SMTP delivery is not implemented yet.
# Generate secrets, e.g.:
#   JWT_SECRET:           python -c "import secrets;print(secrets.token_urlsafe(48))"
#   FIELD_ENCRYPTION_KEY: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# --- Service-to-service (core -> ml-engine) ---
ML_ENGINE_URL=http://ml-engine:8100
ML_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# --- ML engine ---
ML_PORT=8100
MLFLOW_TRACKING_URI=http://mlflow:5000
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=small
LLM_PROVIDER=local
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=CHANGE_ME
HOSTED_LLM_API_KEY=

# --- Object storage ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=wellness-reports
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Containers ---
POSTGRES_USER=wellness
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wellness
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Mobile (build-time, public values only) ---
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
