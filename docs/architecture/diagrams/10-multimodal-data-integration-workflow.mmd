flowchart TB
    subgraph DEV["On the phone"]
        HK["Apple HealthKit"]
        HC["Android Health Connect"]
        PERM["User grants per-metric permission"]
    end
    PERM --> HK
    PERM --> HC
    HK --> RD["Read on device"]
    HC --> RD
